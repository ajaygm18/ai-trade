# Environment Configuration
DEBUG=true
LOG_LEVEL=INFO

# Broker Configuration (Example: Zerodha Kite Connect)
BROKER_NAME=kite
BROKER_API_KEY=your_api_key_here
BROKER_API_SECRET=your_api_secret_here
BROKER_ACCESS_TOKEN=your_access_token_here
BROKER_USER_ID=your_user_id_here

# Database Configuration
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token
INFLUXDB_ORG=trading_org
INFLUXDB_BUCKET=trading_data

REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://user:password@localhost:5432/trading_db

# Trading Configuration
INITIAL_CAPITAL=100000
MAX_POSITION_SIZE=0.1
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.1
RISK_FREE_RATE=0.06

# AI Model Configuration
MODEL_PATH=models/
LSTM_SEQUENCE_LENGTH=60
LSTM_HIDDEN_SIZE=50
TRANSFORMER_HEADS=8
RL_ENVIRONMENT=TradingEnv-v1

# Data Configuration
DATA_PROVIDER=yfinance
SYMBOLS=RELIANCE,TCS,INFY,HDFC,ICICIBANK
TIMEFRAME=1D
LOOKBACK_DAYS=252

# Risk Management
MAX_ORDERS_PER_MINUTE=10
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
POSITION_SIZING=kelly

# Monitoring
DASHBOARD_PORT=8501
API_PORT=8000
METRICS_PORT=9090

# Compliance (SEBI)
ALGO_ID=your_algo_id
STATIC_IP=your_static_ip
AUDIT_LOG_RETENTION_DAYS=90